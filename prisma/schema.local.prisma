// LOCAL DEVELOPMENT SCHEMA — SQLite
// Arrays stored as JSON text, enums stored as plain String.
// Use: npm run dev:local

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("RECRUITER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Client {
  id          String     @id @default(cuid())
  name        String
  industry    String
  contactName String
  email       String
  phone       String?
  website     String?
  notes       String?
  status      String     @default("ACTIVE")
  jobOrders   JobOrder[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Candidate {
  id             String        @id @default(cuid())
  firstName      String
  lastName       String
  email          String        @unique
  phone          String?
  currentTitle   String?
  currentCompany String?
  industry       String?
  skills         String        @default("[]")
  resumeUrl      String?
  linkedinUrl    String?
  notes          String?
  applications   Application[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model JobOrder {
  id           String        @id @default(cuid())
  title        String
  client       Client        @relation(fields: [clientId], references: [id])
  clientId     String
  description  String?
  requirements String        @default("[]")
  salary       String?
  location     String?
  status       String        @default("OPEN")
  applications Application[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Application {
  id          String   @id @default(cuid())
  candidate   Candidate @relation(fields: [candidateId], references: [id])
  candidateId String
  jobOrder    JobOrder  @relation(fields: [jobOrderId], references: [id])
  jobOrderId  String
  stage       String   @default("APPLIED")
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([candidateId, jobOrderId])
}

model Industry {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  icon         String?
  color        String?
  description  String?
  isSystem     Boolean       @default(false)
  isActive     Boolean       @default(true)
  order        Int           @default(0)
  contactTypes ContactType[]
  roles        ContactRole[]
  deals        Deal[]
  products     Product[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model ContactType {
  id         String        @id @default(cuid())
  name       String
  slug       String
  industry   Industry      @relation(fields: [industryId], references: [id], onDelete: Cascade)
  industryId String
  isSystem   Boolean       @default(false)
  isActive   Boolean       @default(true)
  order      Int           @default(0)
  roles      ContactRole[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([industryId, slug])
}

model Contact {
  id         String        @id @default(cuid())
  firstName  String
  lastName   String?
  email      String?
  phone      String?
  phone2     String?
  company    String?
  jobTitle   String?
  address    String?
  city       String?
  state      String?
  country    String?
  website    String?
  instagram  String?
  linkedIn   String?
  currency   String        @default("CAD")
  notes        String?
  followUpDate DateTime?
  followUpNote String?
  tags         String        @default("[]")
  status       String        @default("ACTIVE")
  roles      ContactRole[]
  activities Activity[]
  deals      Deal[]
  orders     Order[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

model ContactRole {
  id            String      @id @default(cuid())
  contact       Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId     String
  industry      Industry    @relation(fields: [industryId], references: [id])
  industryId    String
  contactType   ContactType @relation(fields: [contactTypeId], references: [id])
  contactTypeId String
  customFields  String?
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([contactId, contactTypeId])
}

model Deal {
  id          String    @id @default(cuid())
  title       String
  contact     Contact   @relation(fields: [contactId], references: [id])
  contactId   String
  industry    Industry  @relation(fields: [industryId], references: [id])
  industryId  String
  value       Float?
  currency    String    @default("CAD")
  stage       String    @default("LEAD")
  priority    String    @default("MEDIUM")
  notes       String?
  closingDate DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Activity {
  id        String   @id @default(cuid())
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId String
  type      String   @default("NOTE")
  title     String
  body      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id          String      @id @default(cuid())
  name        String
  sku         String?
  description String?
  image       String?
  category    String?
  price       Float       @default(0)
  cost        Float?
  stock       Int         @default(0)
  lowStockAt  Int         @default(5)
  unit        String      @default("pcs")
  currency    String      @default("CAD")
  isActive    Boolean     @default(true)
  industry    Industry?   @relation(fields: [industryId], references: [id])
  industryId  String?
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Order {
  id            String      @id @default(cuid())
  number        Int         @unique
  contact       Contact     @relation(fields: [contactId], references: [id])
  contactId     String
  status        String      @default("OPEN")
  paymentStatus String      @default("UNPAID")
  subtotal      Float       @default(0)
  discount      Float       @default(0)
  taxRate       Float       @default(0)
  tax           Float       @default(0)
  total         Float       @default(0)
  amountPaid    Float       @default(0)
  currency      String      @default("CAD")
  notes         String?
  items         OrderItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model OrderItem {
  id        String   @id @default(cuid())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId String?
  title     String
  quantity  Float    @default(1)
  price     Float    @default(0)
  total     Float    @default(0)
}
